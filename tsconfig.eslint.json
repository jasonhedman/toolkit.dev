{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@typescript-eslint/eslint-plugin",
        "rules": {
          "@typescript-eslint/no-misused-promises": ["error", {
            "checksVoidReturn": {
              "attributes": false
            }
          }]
        }
      }
    ]
  }
}
